# Supabase Project Configuration — from Project Settings > API in your
# Supabase dashboard. VITE_SUPABASE_PUBLISHABLE_KEY is the "anon" / "public"
# key — safe to ship in client code, RLS policies are what protect the data.
# Admin login is real Supabase Auth now (see supabase/migrations and
# src/stores/authStore.ts) — create the admin user in the Supabase dashboard
# under Authentication > Users, there is nothing to configure here for it.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Form Service Configuration
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Google Sheets Webhook URL for Full Application Log Dumping
VITE_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
